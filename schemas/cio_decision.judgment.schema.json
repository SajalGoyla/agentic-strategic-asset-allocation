{
  "$defs": {
    "BoardMemo": {
      "additionalProperties": false,
      "description": "\u00a73.6: \"a governance document written for non-technical stakeholders\". One field per\nsection the paper requires.",
      "properties": {
        "changes_since_last_review": {
          "title": "Changes Since Last Review",
          "type": "string"
        },
        "expected_performance_vs_benchmark": {
          "title": "Expected Performance Vs Benchmark",
          "type": "string"
        },
        "ips_compliance_statement": {
          "title": "Ips Compliance Statement",
          "type": "string"
        },
        "key_risks": {
          "items": {
            "type": "string"
          },
          "title": "Key Risks",
          "type": "array"
        },
        "largest_positions": {
          "title": "Largest Positions",
          "type": "string"
        },
        "macro_rationale": {
          "title": "Macro Rationale",
          "type": "string"
        },
        "rebalancing_plan": {
          "title": "Rebalancing Plan",
          "type": "string"
        },
        "recommendation": {
          "title": "Recommendation",
          "type": "string"
        }
      },
      "required": [
        "recommendation",
        "expected_performance_vs_benchmark",
        "macro_rationale",
        "largest_positions",
        "changes_since_last_review",
        "key_risks",
        "rebalancing_plan",
        "ips_compliance_statement"
      ],
      "title": "BoardMemo",
      "type": "object"
    },
    "EnsembleMethod": {
      "description": "\u00a73.6's seven combination techniques, plus picking a single method outright.",
      "enum": [
        "single_method",
        "simple_average",
        "inverse_tracking_error",
        "backtest_sharpe_weighted",
        "meta_optimization",
        "regime_conditional",
        "composite_score",
        "trimmed_mean"
      ],
      "title": "EnsembleMethod",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "The CIO's LLM half: which compliant ensemble, and the case to the board.\n\nThe ensembles, their weights and every statistic are computed (``skills/ensemble``); the\nagent narrows ``ensemble_method`` to the ensembles that passed the IPS, so the model can\nonly choose among allocations it is allowed to recommend.",
  "properties": {
    "board_memo": {
      "$ref": "#/$defs/BoardMemo"
    },
    "dissenting_views": {
      "items": {
        "type": "string"
      },
      "title": "Dissenting Views",
      "type": "array"
    },
    "ensemble_method": {
      "$ref": "#/$defs/EnsembleMethod"
    },
    "invalidation_conditions": {
      "items": {
        "type": "string"
      },
      "title": "Invalidation Conditions",
      "type": "array"
    },
    "rationale": {
      "title": "Rationale",
      "type": "string"
    }
  },
  "required": [
    "ensemble_method",
    "rationale",
    "dissenting_views",
    "invalidation_conditions",
    "board_memo"
  ],
  "title": "CioJudgment",
  "type": "object"
}
