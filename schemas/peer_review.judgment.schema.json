    },
    "reviewed_agent_id": {
      "title": "Reviewed Agent Id",
      "type": "string"
    },
    "reviewed_category": {
      "$ref": "#/$defs/PcCategory"
    },
    "reviewer_agent_id": {
      "title": "Reviewer Agent Id",
      "type": "string"
    },
    "reviewer_category": {
      "$ref": "#/$defs/PcCategory"
    },
    "score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Score",
      "type": "number"
    },
    "strengths": {
      "items": {
        "type": "string"
      },
      "title": "Strengths",
      "type": "array"
    },
    "technical_errors": {
      "items": {
        "type": "string"
      },
      "title": "Technical Errors",
      "type": "array"
    },
    "weaknesses": {
      "items": {
        "type": "string"
      },
      "title": "Weaknesses",
      "type": "array"
    }
  },
  "required": [
    "reviewer_agent_id",
    "reviewer_category",
    "reviewed_agent_id",
    "reviewed_category",
    "kind",
    "strengths",
    "weaknesses",
    "technical_errors",
    "score",
    "rationale"
  ],
  "title": "PeerReviewBody",
  "type": "object"
