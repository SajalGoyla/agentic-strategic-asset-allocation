{
  "$defs": {
    "Confidence": {
      "description": "\u00a74.1 classifies the March 2026 regime at \"medium-high confidence\".",
      "enum": [
        "low",
        "medium",
        "medium_high",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "DatasetVersion": {
      "additionalProperties": false,
      "description": "One entry from ``DataStore.provenance()``.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "sha256"
      ],
      "title": "DatasetVersion",
      "type": "object"
    },
    "DimensionRationale": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "dimension",
        "rationale"
      ],
      "title": "DimensionRationale",
      "type": "object"
    },
    "DimensionScore": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "indicators": {
          "items": {
            "$ref": "#/$defs/IndicatorScore"
          },
          "title": "Indicators",
          "type": "array"
        },
        "score": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Score",
          "type": "number"
        }
      },
      "required": [
        "dimension",
        "score",
        "indicators"
      ],
      "title": "DimensionScore",
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "description": "Machine-written envelope. Agents never generate this.",
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "ips_status": {
          "title": "Ips Status",
          "type": "string"
        },
        "ips_version": {
          "title": "Ips Version",
          "type": "number"
        },
        "model_calls": {
          "items": {
            "$ref": "#/$defs/ModelCall"
          },
          "title": "Model Calls",
          "type": "array"
        },
        "pipeline_run_id": {
          "title": "Pipeline Run Id",
          "type": "string"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/DatasetVersion"
          },
          "title": "Provenance",
          "type": "object"
        },
        "report_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Path"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "contract",
        "agent",
        "pipeline_run_id",
        "as_of",
        "generated_at",
        "produced_by",
        "ips_version",
        "ips_status"
      ],
      "title": "Header",
      "type": "object"
    },
    "IndicatorScore": {
      "additionalProperties": false,
      "description": "One FRED series contributing to one dimension.",
      "properties": {
        "available_from": {
          "format": "date",
          "title": "Available From",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "observation_date": {
          "format": "date",
          "title": "Observation Date",
          "type": "string"
        },
        "point_in_time": {
          "title": "Point In Time",
          "type": "boolean"
        },
        "raw_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Value"
        },
        "score": {
          "maximum": 1.0,
          "minimum": -1.0,
          "title": "Score",
          "type": "number"
        },
        "series_id": {
          "title": "Series Id",
          "type": "string"
        },
        "transform": {
          "$ref": "#/$defs/Transform"
        },
        "value": {
          "title": "Value",
          "type": "number"
        },
        "weight": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Weight",
          "type": "number"
        }
      },
      "required": [
        "series_id",
        "name",
        "value",
        "transform",
        "score",
        "weight",
        "observation_date",
        "available_from",
        "point_in_time"
      ],
      "title": "IndicatorScore",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "description": "An upstream contract file this agent read, so the run DAG can be reconstructed.",
      "properties": {
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "contract",
        "path"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "MacroJudgment": {
      "additionalProperties": false,
      "description": "The LLM's structured output. Passed to ``messages.parse(output_format=...)``.\n\nDeliberately narrow: the model classifies and explains, it does not restate the numbers the\nscript already computed.",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "confidence_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence Score",
          "type": "number"
        },
        "dimension_rationales": {
          "items": {
            "$ref": "#/$defs/DimensionRationale"
          },
          "title": "Dimension Rationales",
          "type": "array"
        },
        "key_risks": {
          "items": {
            "type": "string"
          },
          "title": "Key Risks",
          "type": "array"
        },
        "narrative": {
          "title": "Narrative",
          "type": "string"
        },
        "recession_probability": {
          "$ref": "#/$defs/RecessionProbability"
        },
        "regime": {
          "$ref": "#/$defs/Regime"
        },
        "regime_qualifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regime Qualifier"
        }
      },
      "required": [
        "regime",
        "confidence",
        "confidence_score",
        "recession_probability",
        "dimension_rationales",
        "key_risks",
        "narrative"
      ],
      "title": "MacroJudgment",
      "type": "object"
    },
    "MacroScores": {
      "additionalProperties": false,
      "description": "Deterministic output of the regime-scoring script.",
      "properties": {
        "dimensions": {
          "items": {
            "$ref": "#/$defs/DimensionScore"
          },
          "title": "Dimensions",
          "type": "array"
        },
        "lookback_years": {
          "title": "Lookback Years",
          "type": "integer"
        },
        "pit_quality": {
          "items": {
            "$ref": "#/$defs/PitQuality"
          },
          "title": "Pit Quality",
          "type": "array"
        }
      },
      "required": [
        "dimensions",
        "lookback_years"
      ],
      "title": "MacroScores",
      "type": "object"
    },
    "MacroViewBody": {
      "additionalProperties": false,
      "properties": {
        "judgment": {
          "$ref": "#/$defs/MacroJudgment"
        },
        "scores": {
          "$ref": "#/$defs/MacroScores"
        }
      },
      "required": [
        "scores",
        "judgment"
      ],
      "title": "MacroViewBody",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "One LLM call, for the \u00a76 budget and for the \u00a75.1 monoculture question.\n\nThe paper flags LLM monoculture as a risk and suggests multiple foundation models as a\nmitigation; that cannot be analysed after the fact unless each output records which model\nproduced it.",
      "properties": {
        "cache_read_tokens": {
          "default": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "model",
        "tier"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "PitQuality": {
      "additionalProperties": false,
      "description": "How point-in-time a dimension actually was at this ``as_of``.",
      "properties": {
        "dimension": {
          "title": "Dimension",
          "type": "string"
        },
        "indicators_point_in_time": {
          "title": "Indicators Point In Time",
          "type": "integer"
        },
        "indicators_total": {
          "title": "Indicators Total",
          "type": "integer"
        }
      },
      "required": [
        "dimension",
        "indicators_total",
        "indicators_point_in_time"
      ],
      "title": "PitQuality",
      "type": "object"
    },
    "Producer": {
      "description": "Who generated a body: deterministic code, an LLM, or both.",
      "enum": [
        "script",
        "llm",
        "hybrid"
      ],
      "title": "Producer",
      "type": "string"
    },
    "RecessionProbability": {
      "additionalProperties": false,
      "description": "\u00a74.1 reports \"a baseline recession probability of 25-35%\" -- a range, not a point.",
      "properties": {
        "high_pct": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "High Pct",
          "type": "number"
        },
        "low_pct": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Low Pct",
          "type": "number"
        }
      },
      "required": [
        "low_pct",
        "high_pct"
      ],
      "title": "RecessionProbability",
      "type": "object"
    },
    "Regime": {
      "enum": [
        "expansion",
        "late_cycle",
        "recession",
        "recovery"
      ],
      "title": "Regime",
      "type": "string"
    },
    "Tier": {
      "description": "Model routing tier (project plan \u00a76). Recorded so spend is attributable per agent.",
      "enum": [
        "flagship",
        "low_cost"
      ],
      "title": "Tier",
      "type": "string"
    },
    "Transform": {
      "description": "How a raw series was turned into a comparable score.",
      "enum": [
        "level",
        "yoy",
        "mom_annualised",
        "zscore",
        "percentile",
        "diff"
      ],
      "title": "Transform",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "$ref": "#/$defs/MacroViewBody"
    },
    "header": {
      "$ref": "#/$defs/Header"
    }
  },
  "required": [
    "header",
    "body"
  ],
  "title": "AgentOutput[MacroViewBody]",
  "type": "object"
}
