{
  "$defs": {
    "CmaBody": {
      "additionalProperties": false,
      "properties": {
        "asset_id": {
          "title": "Asset Id",
          "type": "string"
        },
        "expected_return_pct": {
          "title": "Expected Return Pct",
          "type": "number"
        },
        "horizon_years": {
          "title": "Horizon Years",
          "type": "integer"
        },
        "judgment": {
          "$ref": "#/$defs/CmaJudgment"
        },
        "method_range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Method Range",
          "type": "array"
        },
        "volatility_pct": {
          "title": "Volatility Pct",
          "type": "number"
        }
      },
      "required": [
        "asset_id",
        "horizon_years",
        "expected_return_pct",
        "volatility_pct",
        "method_range",
        "judgment"
      ],
      "title": "CmaBody",
      "type": "object"
    },
    "CmaJudgment": {
      "additionalProperties": false,
      "description": "The CMA judge's structured output -- the LLM half of the asset-class agent.\n\nFields follow the five judgment steps of Exhibit 4, so the rationale is forced to cover\ndispersion, regime, valuation and signal alignment rather than a bare assertion.",
      "properties": {
        "confidence": {
          "$ref": "#/$defs/Confidence"
        },
        "dispersion": {
          "$ref": "#/$defs/Dispersion"
        },
        "expected_return_pct": {
          "title": "Expected Return Pct",
          "type": "number"
        },
        "method_weights": {
          "additionalProperties": {
            "type": "number"
          },
          "propertyNames": {
            "$ref": "#/$defs/CmaMethodId"
          },
          "title": "Method Weights",
          "type": "object"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "regime_logic": {
          "title": "Regime Logic",
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/SelectionMode"
        },
        "signal_alignment": {
          "title": "Signal Alignment",
          "type": "string"
        },
        "valuation_context": {
          "title": "Valuation Context",
          "type": "string"
        }
      },
      "required": [
        "selection",
        "method_weights",
        "expected_return_pct",
        "confidence",
        "dispersion",
        "regime_logic",
        "valuation_context",
        "signal_alignment",
        "rationale"
      ],
      "title": "CmaJudgment",
      "type": "object"
    },
    "CmaMethodId": {
      "description": "The seven candidates of Exhibit 4.",
      "enum": [
        "historical_erp",
        "regime_adjusted",
        "bl_equilibrium",
        "inverse_gordon",
        "implied_erp_cape",
        "survey_consensus",
        "auto_blend"
      ],
      "title": "CmaMethodId",
      "type": "string"
    },
    "Confidence": {
      "description": "\u00a74.1 classifies the March 2026 regime at \"medium-high confidence\".",
      "enum": [
        "low",
        "medium",
        "medium_high",
        "high"
      ],
      "title": "Confidence",
      "type": "string"
    },
    "DatasetVersion": {
      "additionalProperties": false,
      "description": "One entry from ``DataStore.provenance()``.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "sha256"
      ],
      "title": "DatasetVersion",
      "type": "object"
    },
    "Dispersion": {
      "description": "Exhibit 4 step 1: \"tight <3pp / moderate 3-6pp / wide >6pp\".",
      "enum": [
        "tight",
        "moderate",
        "wide"
      ],
      "title": "Dispersion",
      "type": "string"
    },
    "Header": {
      "additionalProperties": false,
      "description": "Machine-written envelope. Agents never generate this.",
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "ips_status": {
          "title": "Ips Status",
          "type": "string"
        },
        "ips_version": {
          "title": "Ips Version",
          "type": "number"
        },
        "model_calls": {
          "items": {
            "$ref": "#/$defs/ModelCall"
          },
          "title": "Model Calls",
          "type": "array"
        },
        "pipeline_run_id": {
          "title": "Pipeline Run Id",
          "type": "string"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/DatasetVersion"
          },
          "title": "Provenance",
          "type": "object"
        },
        "report_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Path"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "contract",
        "agent",
        "pipeline_run_id",
        "as_of",
        "generated_at",
        "produced_by",
        "ips_version",
        "ips_status"
      ],
      "title": "Header",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "description": "An upstream contract file this agent read, so the run DAG can be reconstructed.",
      "properties": {
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "contract",
        "path"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "One LLM call, for the \u00a76 budget and for the \u00a75.1 monoculture question.\n\nThe paper flags LLM monoculture as a risk and suggests multiple foundation models as a\nmitigation; that cannot be analysed after the fact unless each output records which model\nproduced it.",
      "properties": {
        "cache_read_tokens": {
          "default": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "model",
        "tier"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "Producer": {
      "description": "Who generated a body: deterministic code, an LLM, or both.",
      "enum": [
        "script",
        "llm",
        "hybrid"
      ],
      "title": "Producer",
      "type": "string"
    },
    "SelectionMode": {
      "description": "Exhibit 4 step 5: \"pick one method, define custom weights, or accept blend\".",
      "enum": [
        "single_method",
        "custom_blend",
        "auto_blend"
      ],
      "title": "SelectionMode",
      "type": "string"
    },
    "Tier": {
      "description": "Model routing tier (project plan \u00a76). Recorded so spend is attributable per agent.",
      "enum": [
        "flagship",
        "low_cost"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "$ref": "#/$defs/CmaBody"
    },
    "header": {
      "$ref": "#/$defs/Header"
    }
  },
  "required": [
    "header",
    "body"
  ],
  "title": "AgentOutput[CmaBody]",
  "type": "object"
}
