{
  "$defs": {
    "CovarianceBody": {
      "additionalProperties": false,
      "description": "Annualised covariance matrix over the universe, row/column order given by ``asset_ids``.\n\nUnits: ``matrix`` is in decimal-squared (a 20% volatility is a variance of 0.04), the form\noptimisers consume; ``volatilities_pct`` is percent, like every other ``_pct`` field. The\nvalidator checks the two agree, which catches a matrix written in percent-squared.",
      "properties": {
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "judgment": {
          "anyOf": [
            {
              "$ref": "#/$defs/CovarianceJudgment"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "matrix": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        },
        "method": {
          "$ref": "#/$defs/CovarianceMethod"
        },
        "regime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Regime"
        },
        "shrinkage": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Shrinkage"
        },
        "validation": {
          "items": {
            "$ref": "#/$defs/EstimatorValidation"
          },
          "title": "Validation",
          "type": "array"
        },
        "volatilities_pct": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Volatilities Pct",
          "type": "object"
        },
        "window_years": {
          "title": "Window Years",
          "type": "number"
        }
      },
      "required": [
        "asset_ids",
        "method",
        "window_years",
        "matrix",
        "volatilities_pct"
      ],
      "title": "CovarianceBody",
      "type": "object"
    },
    "CovarianceJudgment": {
      "additionalProperties": false,
      "description": "The covariance agent's LLM half (decision 63): which validated estimator to hand the PC\nagents, given the macro regime and each estimator's out-of-sample record. The matrices and\nthe record are computed; the model only chooses among them and says why.",
      "properties": {
        "method": {
          "$ref": "#/$defs/CovarianceMethod"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "what_would_change_it": {
          "title": "What Would Change It",
          "type": "string"
        }
      },
      "required": [
        "method",
        "rationale",
        "what_would_change_it"
      ],
      "title": "CovarianceJudgment",
      "type": "object"
    },
    "CovarianceMethod": {
      "enum": [
        "sample",
        "ledoit_wolf",
        "exponential",
        "regime_conditional"
      ],
      "title": "CovarianceMethod",
      "type": "string"
    },
    "DatasetVersion": {
      "additionalProperties": false,
      "description": "One entry from ``DataStore.provenance()``.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "sha256"
      ],
      "title": "DatasetVersion",
      "type": "object"
    },
    "EstimatorValidation": {
      "additionalProperties": false,
      "description": "One estimator's forecasts checked against what followed (decision 63).\n\nAt each year-end the estimator is fitted on data to that date only; its volatility forecast\nfor the IPS benchmark and for equal weight is compared with the volatility realised over the\nnext 12 months, and its stock-bond correlation with the one realised over the next 36.",
      "properties": {
        "abs_log_error": {
          "minimum": 0.0,
          "title": "Abs Log Error",
          "type": "number"
        },
        "method": {
          "$ref": "#/$defs/CovarianceMethod"
        },
        "realised_to_forecast": {
          "exclusiveMinimum": 0.0,
          "title": "Realised To Forecast",
          "type": "number"
        },
        "stock_bond_correlation_error": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stock Bond Correlation Error"
        },
        "years": {
          "minimum": 1,
          "title": "Years",
          "type": "integer"
        }
      },
      "required": [
        "method",
        "years",
        "realised_to_forecast",
        "abs_log_error"
      ],
      "title": "EstimatorValidation",
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "description": "Machine-written envelope. Agents never generate this.",
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "ips_status": {
          "title": "Ips Status",
          "type": "string"
        },
        "ips_version": {
          "title": "Ips Version",
          "type": "number"
        },
        "model_calls": {
          "items": {
            "$ref": "#/$defs/ModelCall"
          },
          "title": "Model Calls",
          "type": "array"
        },
        "pipeline_run_id": {
          "title": "Pipeline Run Id",
          "type": "string"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/DatasetVersion"
          },
          "title": "Provenance",
          "type": "object"
        },
        "report_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Path"
        },
        "schema_version": {
          "default": "5.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "contract",
        "agent",
        "pipeline_run_id",
        "as_of",
        "generated_at",
        "produced_by",
        "ips_version",
        "ips_status"
      ],
      "title": "Header",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "description": "An upstream contract file this agent read, so the run DAG can be reconstructed.",
      "properties": {
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "contract",
        "path"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "One LLM call, for the \u00a76 budget and for the \u00a75.1 monoculture question.\n\nThe paper flags LLM monoculture as a risk and suggests multiple foundation models as a\nmitigation; that cannot be analysed after the fact unless each output records which model\nproduced it.",
      "properties": {
        "attempts": {
          "default": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "cache_read_tokens": {
          "default": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "model",
        "tier"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "Producer": {
      "description": "Who generated a body: deterministic code, an LLM, or both.",
      "enum": [
        "script",
        "llm",
        "hybrid"
      ],
      "title": "Producer",
      "type": "string"
    },
    "Tier": {
      "description": "Model routing tier (project plan \u00a76). Recorded so spend is attributable per agent.",
      "enum": [
        "flagship",
        "low_cost"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "$ref": "#/$defs/CovarianceBody"
    },
    "header": {
      "$ref": "#/$defs/Header"
    }
  },
  "required": [
    "header",
    "body"
  ],
  "title": "AgentOutput[CovarianceBody]",
  "type": "object"
}
