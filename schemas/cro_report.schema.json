{
  "$defs": {
    "CroJudgment": {
      "additionalProperties": false,
      "description": "The CRO's LLM half: what the metrics mean for this portfolio.\n\nThe numbers are not in here. ``risk_score`` and every metric are computed by the risk\nskill, because the CIO blends the CRO's score with the vote (\u00a73.5) and compares it across\n15 candidates -- a number a model assigns portfolio by portfolio is not comparable, and\ncannot be reproduced from the run inputs (decision 34). What the model adds is the reading\nof them: which risk actually binds, and whether a breach is the method working or failing.",
      "properties": {
        "commentary": {
          "title": "Commentary",
          "type": "string"
        },
        "concentration_assessment": {
          "title": "Concentration Assessment",
          "type": "string"
        },
        "ips_assessment": {
          "title": "Ips Assessment",
          "type": "string"
        },
        "key_risks": {
          "items": {
            "type": "string"
          },
          "title": "Key Risks",
          "type": "array"
        },
        "tail_risk_assessment": {
          "title": "Tail Risk Assessment",
          "type": "string"
        }
      },
      "required": [
        "key_risks",
        "concentration_assessment",
        "tail_risk_assessment",
        "ips_assessment",
        "commentary"
      ],
      "title": "CroJudgment",
      "type": "object"
    },
    "CroReportBody": {
      "additionalProperties": false,
      "description": "One standardised risk report. The CRO scores and comments; it never votes.\n\nEvery field above ``judgment`` is computed by ``saa.skills.risk``. Units follow the\nproject convention -- percent with a ``_pct`` suffix, ratios bare -- with two specifics\nthe paper leaves open: ``var_95_pct`` is the *monthly* historical 95% value-at-risk stated\nas a loss, and ``max_drawdown_pct`` is negative, matching the IPS limit it is checked\nagainst. A VaR stated as a loss can come out negative, and that is not an error -- a\ncash-heavy portfolio whose fifth-percentile month is still a gain has a negative 95% VaR,\nwhich is exactly what the reader should see.",
      "properties": {
        "backtest_months": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backtest Months"
        },
        "backtest_sharpe": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backtest Sharpe"
        },
        "backtest_volatility_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Backtest Volatility Pct"
        },
        "category": {
          "$ref": "#/$defs/PcCategory"
        },
        "concentration_hhi": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Concentration Hhi"
        },
        "cvar_95_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cvar 95 Pct"
        },
        "effective_n": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective N"
        },
        "ex_ante_tracking_error_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ex Ante Tracking Error Pct"
        },
        "ex_ante_volatility_pct": {
          "title": "Ex Ante Volatility Pct",
          "type": "number"
        },
        "factor_tilts": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Factor Tilts",
          "type": "object"
        },
        "ips_compliance": {
          "$ref": "#/$defs/IpsCompliance"
        },
        "judgment": {
          "$ref": "#/$defs/CroJudgment"
        },
        "max_drawdown_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Drawdown Pct"
        },
        "method": {
          "title": "Method",
          "type": "string"
        },
        "portfolio_agent_id": {
          "title": "Portfolio Agent Id",
          "type": "string"
        },
        "risk_score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Risk Score",
          "type": "number"
        },
        "risk_score_components": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Risk Score Components",
          "type": "object"
        },
        "var_95_pct": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Var 95 Pct"
        }
      },
      "required": [
        "portfolio_agent_id",
        "method",
        "category",
        "ex_ante_volatility_pct",
        "ips_compliance",
        "risk_score",
        "judgment"
      ],
      "title": "CroReportBody",
      "type": "object"
    },
    "DatasetVersion": {
      "additionalProperties": false,
      "description": "One entry from ``DataStore.provenance()``.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "sha256"
      ],
      "title": "DatasetVersion",
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "description": "Machine-written envelope. Agents never generate this.",
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "ips_status": {
          "title": "Ips Status",
          "type": "string"
        },
        "ips_version": {
          "title": "Ips Version",
          "type": "number"
        },
        "model_calls": {
          "items": {
            "$ref": "#/$defs/ModelCall"
          },
          "title": "Model Calls",
          "type": "array"
        },
        "pipeline_run_id": {
          "title": "Pipeline Run Id",
          "type": "string"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/DatasetVersion"
          },
          "title": "Provenance",
          "type": "object"
        },
        "report_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Path"
        },
        "schema_version": {
          "default": "5.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "contract",
        "agent",
        "pipeline_run_id",
        "as_of",
        "generated_at",
        "produced_by",
        "ips_version",
        "ips_status"
      ],
      "title": "Header",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "description": "An upstream contract file this agent read, so the run DAG can be reconstructed.",
      "properties": {
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "contract",
        "path"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "IpsCompliance": {
      "additionalProperties": false,
      "description": "\u00a73.5: the CRO checks IPS compliance for every candidate; \u00a73.6: the CIO is bound by it.",
      "properties": {
        "compliant": {
          "title": "Compliant",
          "type": "boolean"
        },
        "not_evaluated": {
          "items": {
            "type": "string"
          },
          "title": "Not Evaluated",
          "type": "array"
        },
        "violations": {
          "items": {
            "$ref": "#/$defs/Violation"
          },
          "title": "Violations",
          "type": "array"
        }
      },
      "required": [
        "compliant"
      ],
      "title": "IpsCompliance",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "One LLM call, for the \u00a76 budget and for the \u00a75.1 monoculture question.\n\nThe paper flags LLM monoculture as a risk and suggests multiple foundation models as a\nmitigation; that cannot be analysed after the fact unless each output records which model\nproduced it.",
      "properties": {
        "attempts": {
          "default": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "cache_read_tokens": {
          "default": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "model",
        "tier"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "PcCategory": {
      "description": "Exhibit 5's four families, plus the researcher's own slot (Exhibit 9 lists it as\n\"E: PC-Researcher\").",
      "enum": [
        "heuristic",
        "return_optimized",
        "risk_structured",
        "non_traditional",
        "pc_researcher"
      ],
      "title": "PcCategory",
      "type": "string"
    },
    "Producer": {
      "description": "Who generated a body: deterministic code, an LLM, or both.",
      "enum": [
        "script",
        "llm",
        "hybrid"
      ],
      "title": "Producer",
      "type": "string"
    },
    "Tier": {
      "description": "Model routing tier (project plan \u00a76). Recorded so spend is attributable per agent.",
      "enum": [
        "flagship",
        "low_cost"
      ],
      "title": "Tier",
      "type": "string"
    },
    "Violation": {
      "additionalProperties": false,
      "description": "Mirrors ``saa.ips.Violation`` so compliance can be embedded in a contract.",
      "properties": {
        "entity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Entity"
        },
        "limit": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Limit"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "observed": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed"
        },
        "rule": {
          "title": "Rule",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        }
      },
      "required": [
        "rule",
        "severity",
        "message"
      ],
      "title": "Violation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "$ref": "#/$defs/CroReportBody"
    },
    "header": {
      "$ref": "#/$defs/Header"
    }
  },
  "required": [
    "header",
    "body"
  ],
  "title": "AgentOutput[CroReportBody]",
  "type": "object"
}
