{
  "$defs": {
    "DatasetVersion": {
      "additionalProperties": false,
      "description": "One entry from ``DataStore.provenance()``.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "run_id",
        "sha256"
      ],
      "title": "DatasetVersion",
      "type": "object"
    },
    "Header": {
      "additionalProperties": false,
      "description": "Machine-written envelope. Agents never generate this.",
      "properties": {
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "as_of": {
          "format": "date",
          "title": "As Of",
          "type": "string"
        },
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "generated_at": {
          "format": "date-time",
          "title": "Generated At",
          "type": "string"
        },
        "inputs": {
          "items": {
            "$ref": "#/$defs/InputRef"
          },
          "title": "Inputs",
          "type": "array"
        },
        "ips_status": {
          "title": "Ips Status",
          "type": "string"
        },
        "ips_version": {
          "title": "Ips Version",
          "type": "number"
        },
        "model_calls": {
          "items": {
            "$ref": "#/$defs/ModelCall"
          },
          "title": "Model Calls",
          "type": "array"
        },
        "pipeline_run_id": {
          "title": "Pipeline Run Id",
          "type": "string"
        },
        "produced_by": {
          "$ref": "#/$defs/Producer"
        },
        "provenance": {
          "additionalProperties": {
            "$ref": "#/$defs/DatasetVersion"
          },
          "title": "Provenance",
          "type": "object"
        },
        "report_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Report Path"
        },
        "schema_version": {
          "default": "0.1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        }
      },
      "required": [
        "contract",
        "agent",
        "pipeline_run_id",
        "as_of",
        "generated_at",
        "produced_by",
        "ips_version",
        "ips_status"
      ],
      "title": "Header",
      "type": "object"
    },
    "InputRef": {
      "additionalProperties": false,
      "description": "An upstream contract file this agent read, so the run DAG can be reconstructed.",
      "properties": {
        "contract": {
          "title": "Contract",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sha256"
        }
      },
      "required": [
        "contract",
        "path"
      ],
      "title": "InputRef",
      "type": "object"
    },
    "ModelCall": {
      "additionalProperties": false,
      "description": "One LLM call, for the \u00a76 budget and for the \u00a75.1 monoculture question.\n\nThe paper flags LLM monoculture as a risk and suggests multiple foundation models as a\nmitigation; that cannot be analysed after the fact unless each output records which model\nproduced it.",
      "properties": {
        "cache_read_tokens": {
          "default": 0,
          "title": "Cache Read Tokens",
          "type": "integer"
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cost Usd"
        },
        "effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effort"
        },
        "input_tokens": {
          "default": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "model": {
          "title": "Model",
          "type": "string"
        },
        "output_tokens": {
          "default": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "tier": {
          "$ref": "#/$defs/Tier"
        }
      },
      "required": [
        "model",
        "tier"
      ],
      "title": "ModelCall",
      "type": "object"
    },
    "PcCategory": {
      "description": "Exhibit 5's four families, plus the researcher's own slot (Exhibit 9 lists it as\n\"E: PC-Researcher\").",
      "enum": [
        "heuristic",
        "return_optimized",
        "risk_structured",
        "non_traditional",
        "pc_researcher"
      ],
      "title": "PcCategory",
      "type": "string"
    },
    "PeerReviewBody": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/ReviewKind"
        },
        "rationale": {
          "title": "Rationale",
          "type": "string"
        },
        "reviewed_agent_id": {
          "title": "Reviewed Agent Id",
          "type": "string"
        },
        "reviewed_category": {
          "$ref": "#/$defs/PcCategory"
        },
        "reviewer_agent_id": {
          "title": "Reviewer Agent Id",
          "type": "string"
        },
        "reviewer_category": {
          "$ref": "#/$defs/PcCategory"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "strengths": {
          "items": {
            "type": "string"
          },
          "title": "Strengths",
          "type": "array"
        },
        "technical_errors": {
          "items": {
            "type": "string"
          },
          "title": "Technical Errors",
          "type": "array"
        },
        "weaknesses": {
          "items": {
            "type": "string"
          },
          "title": "Weaknesses",
          "type": "array"
        }
      },
      "required": [
        "reviewer_agent_id",
        "reviewer_category",
        "reviewed_agent_id",
        "reviewed_category",
        "kind",
        "strengths",
        "weaknesses",
        "score",
        "rationale"
      ],
      "title": "PeerReviewBody",
      "type": "object"
    },
    "Producer": {
      "description": "Who generated a body: deterministic code, an LLM, or both.",
      "enum": [
        "script",
        "llm",
        "hybrid"
      ],
      "title": "Producer",
      "type": "string"
    },
    "ReviewKind": {
      "description": "Intra-category review \"is more likely to identify technical errors within a shared\nframework\"; inter-category review \"can challenge foundational assumptions\".",
      "enum": [
        "intra_category",
        "inter_category"
      ],
      "title": "ReviewKind",
      "type": "string"
    },
    "Tier": {
      "description": "Model routing tier (project plan \u00a76). Recorded so spend is attributable per agent.",
      "enum": [
        "flagship",
        "low_cost"
      ],
      "title": "Tier",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "body": {
      "$ref": "#/$defs/PeerReviewBody"
    },
    "header": {
      "$ref": "#/$defs/Header"
    }
  },
  "required": [
    "header",
    "body"
  ],
  "title": "AgentOutput[PeerReviewBody]",
  "type": "object"
}
