# Copy to .env (git-ignored) and fill in.

# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
# Without it, FRED data is pulled keyless (latest vintage only, no revision history).
FRED_API_KEY=

# Your WRDS username. The password is NOT stored here: the one-time login in the README saves it
# to the PostgreSQL password file (%APPDATA%\postgresql\pgpass.conf on Windows).
WRDS_USERNAME=

# Needed by the LLM agents (`saa-agent`). Not used by data ingestion, and not needed
# for `saa-agent macro --no-llm`, which runs the deterministic scoring only.
ANTHROPIC_API_KEY=
# Anthropic model per tier (defaults: claude-opus-5-5 and claude-sonnet-5-5). Which agent uses
# which tier is saa.llm.AGENT_TIERS (decision 51).
# SAA_ANTHROPIC_MODEL_FLAGSHIP=claude-opus-5-5
# SAA_ANTHROPIC_MODEL_LOW_COST=claude-sonnet-5-5

# Which LLM provider the agents call: `anthropic` (default; the paid runs), or `openrouter`
# or `gemini` (dry runs on free models, to check the machinery). Leave unset for Anthropic.
# SAA_LLM_PROVIDER=openrouter

# OpenRouter key, from https://openrouter.ai/keys. Free models allow 20 requests a minute and
# 50 a day, or 1,000 a day once $10 of credit has been bought (one full run is ~100 calls).
OPENROUTER_API_KEY=

# OpenRouter model for both tiers (default: nvidia/nemotron-3-super-120b-a12b:free). Must
# support structured outputs. Per-tier overrides and the pacing rate are optional.
# SAA_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# SAA_OPENROUTER_MODEL_FLAGSHIP=
# SAA_OPENROUTER_MODEL_LOW_COST=
# SAA_OPENROUTER_RPM=18

# Gemini key, from https://aistudio.google.com/apikey (SAA_LLM_PROVIDER=gemini). Free-tier
# limits are per model and shown in AI Studio, e.g. 15 a minute and 500 a day on a Flash Lite
# model. Default model for both tiers: gemini-3.1-flash-lite. Per-tier overrides split the
# daily quota across two models.
GEMINI_API_KEY=
# SAA_GEMINI_MODEL=gemini-3.1-flash-lite
# SAA_GEMINI_MODEL_FLAGSHIP=gemini-3.5-flash-lite
# SAA_GEMINI_MODEL_LOW_COST=gemini-3.1-flash-lite
# SAA_GEMINI_RPM=14

# Optional overrides
# SAA_DATA_DIR=/absolute/path/to/data
# SAA_CONFIG_DIR=/absolute/path/to/config
